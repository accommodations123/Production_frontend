# ──────────────────────────────────────────────────────────
# Supabase & Application Environment Configuration (.env.example)
# Copy this to .env and fill in your values.
# Only VITE_* variables are exposed to the browser by Vite.
# ──────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=https://your-project.supabase.co/functions/v1
VITE_SOCKET_URL=https://your-project.supabase.co
VITE_FRONTEND_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5173


